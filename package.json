{
  "name": "@frostime/siyuan-plugin-kits",
  "version": "1.7.0",
  "type": "module",
  "description": "A utility for SiYuan plugin development",
  "repository": {
    "type": "git",
    "url": "https://github.com/frostime/siyuan-plugin-kits.git"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api": {
      "types": "./dist/types/api.d.ts",
      "import": "./dist/api.mjs",
      "require": "./dist/api.cjs"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/element.mjs",
      "require": "./dist/element.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "frostime",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.63.1",
    "rollup-plugin-delete": "^3.0.2",
    "siyuan": "1.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "siyuan": ">=1.2.4 <2"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
