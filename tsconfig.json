{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],

    "declaration": true,
    "declarationDir": "./dist/types",

    "strict": false,
    "noEmitOnError": true,

    "esModuleInterop": true,

    "paths": {
      "@/*": ["./src/*"],
    },
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "**/*.test.ts"],
}
